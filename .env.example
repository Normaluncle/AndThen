# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- HTTP ----
# API listens on this host/port. 0.0.0.0 is only safe inside a container network.
HOST=127.0.0.1
PORT=8080
# Public base URL used for links (invitations etc.). Never a secret.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Fixed fixture login only; disabled by default, never enable on public hosting.
LOCAL_DEMO_LOGIN=false

# ---- Database ----
# Postgres 18. Inside compose the host is `db`.
DATABASE_URL=postgres://andthen:andthen@127.0.0.1:5432/andthen
# Pool sizing.
DB_POOL_MAX=10

# ---- LLM (OpenAI-compatible) ----
# Independent provider. Left blank by default; AI handlers stay disabled until
# LLM_BASE_URL and LLM_MODEL are set, and manual mode is unaffected.
#
# API key policy: a key is NOT required. Anonymous local providers
# (ollama / llama.cpp / vLLM on loopback or a private address) work without one.
# A remote base URL with no key is logged as a warning at boot.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_BYTES=131072
LLM_MAX_RESPONSE_BYTES=131072
LLM_MAX_OUTPUT_TOKENS=4096
# Shared database-wide AI job lease cap; keep identical across worker replicas.
LLM_MAX_CONCURRENT_JOBS=2
# UTC-day job admission ceiling (includes cancelled/failed jobs, not a money bill).
LLM_DAILY_JOB_LIMIT=1000

# ---- Jobs / worker ----
# WORKER_ID is optional, but a stable value is required for the worker container
# healthcheck (it reads this worker's row from worker_heartbeats).
WORKER_ID=
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=60
JOB_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5
# The worker healthcheck fails when the newest heartbeat is older than this.
WORKER_HEALTH_MAX_AGE_SECONDS=60

# ---- Auth ----
# Session lifetime in seconds (default 30 days).
SESSION_TTL_SECONDS=2592000
# Bootstrap login-token lifetime in seconds (default 1 hour).
LOGIN_TOKEN_TTL_SECONDS=3600

# Zhihu OAuth (keep disabled until the official state callback is verified)
ZHIHU_APP_ID=
ZHIHU_APP_KEY=
ZHIHU_REDIRECT_URI=
ZHIHU_OAUTH_STATE_VERIFIED=false
# Generate a private 32-byte hex key; retain it securely across restarts.
ZHIHU_TOKEN_ENCRYPTION_KEY=

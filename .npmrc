# Project-level registry pin.
#
# This lockfile was produced against the mirror below, and container builds must
# resolve the same way. Nothing global is changed: this only affects installs run
# from this directory. If your environment reaches registry.npmjs.org reliably,
# change the registry here (and regenerate pnpm-lock.yaml).
registry=https://registry.npmmirror.com

# Network resilience: container builds and CI links can be flaky.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
network-concurrency=4
